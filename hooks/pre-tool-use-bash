#!/usr/bin/env bash
# Shipworthy — Pre-Tool-Use Hook (Bash)
# Fires before Bash commands. Catches destructive operations BEFORE execution.
# Advisory only: never blocks, only suggests. Every check is config-gated.

set -euo pipefail

# --- Error recovery: always output valid JSON ---
trap 'echo "{\"hookSpecificOutput\":{\"decision\":\"approve\"}}"' ERR

# --- Source shared library ---
PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$PLUGIN_ROOT/hooks/lib.sh" 2>/dev/null || true

# --- Read tool input from stdin ---
INPUT=$(cat 2>/dev/null || true)

if [ -z "$INPUT" ]; then
  echo '{"hookSpecificOutput":{"decision":"approve"}}'
  exit 0
fi

# --- Extract command using robust parser, with full input as search fallback ---
COMMAND=$(parse_json_field "$INPUT" "command" 2>/dev/null || true)
SEARCH_TARGET="${COMMAND:-$INPUT}"

if [ -z "$COMMAND" ] && [ -z "$SEARCH_TARGET" ]; then
  echo '{"hookSpecificOutput":{"decision":"approve"}}'
  exit 0
fi

# --- Resolve project root ---
PROJECT_ROOT="$(timeout 2 git rev-parse --show-toplevel 2>/dev/null || pwd)"

sw_log security pre-tool-use-bash "Scanning: $(echo "$SEARCH_TARGET" | head -c 60)"

WARNINGS=""

# ============================================================
# Check 1: Destructive file operations
# Config: rules.destructive_commands (default: enabled)
# ============================================================
if is_rule_enabled "destructive_commands" "$PROJECT_ROOT"; then
  if echo "$SEARCH_TARGET" | grep -qE 'rm\s+(-[a-zA-Z]*r[a-zA-Z]*f|--recursive|--force)' 2>/dev/null; then
    sw_check pre-tool-use-bash "Destructive rm" warn
    WARNINGS="${WARNINGS}Heads up: destructive rm detected (recursive/force). Double-check the target paths. "
  fi
fi

# ============================================================
# Check 2: Destructive git operations
# Config: rules.destructive_git (default: enabled)
# ============================================================
if is_rule_enabled "destructive_git" "$PROJECT_ROOT"; then
  if echo "$SEARCH_TARGET" | grep -qE 'git\s+push\s+.*(--force\b|-f\b)' 2>/dev/null; then
    if ! echo "$SEARCH_TARGET" | grep -q 'force-with-lease' 2>/dev/null; then
      sw_check pre-tool-use-bash "Force push" warn
      WARNINGS="${WARNINGS}Heads up: git push --force rewrites remote history. Consider --force-with-lease as a safer alternative. "
    fi
  fi

  if echo "$SEARCH_TARGET" | grep -qE 'git\s+reset\s+--hard' 2>/dev/null; then
    sw_check pre-tool-use-bash "Hard reset" warn
    WARNINGS="${WARNINGS}Heads up: git reset --hard discards uncommitted changes permanently. "
  fi

  if echo "$SEARCH_TARGET" | grep -qE 'git\s+clean\s+-[a-zA-Z]*f' 2>/dev/null; then
    sw_check pre-tool-use-bash "Git clean" warn
    WARNINGS="${WARNINGS}Heads up: git clean -f permanently removes untracked files. "
  fi

  if echo "$SEARCH_TARGET" | grep -qE 'git\s+checkout\s+--\s+\.' 2>/dev/null; then
    sw_check pre-tool-use-bash "Checkout discard" warn
    WARNINGS="${WARNINGS}Heads up: git checkout -- . discards all unstaged changes. "
  fi

  if echo "$SEARCH_TARGET" | grep -qE 'git\s+branch\s+-D' 2>/dev/null; then
    sw_check pre-tool-use-bash "Force branch delete" warn
    WARNINGS="${WARNINGS}Heads up: git branch -D force-deletes a branch regardless of merge status. "
  fi
fi

# ============================================================
# Check 3: Destructive database operations
# Config: rules.destructive_db (default: enabled)
# ============================================================
if is_rule_enabled "destructive_db" "$PROJECT_ROOT"; then
  if echo "$SEARCH_TARGET" | grep -qiE '(DROP\s+(TABLE|DATABASE|SCHEMA|INDEX)|TRUNCATE\s+TABLE|DELETE\s+FROM\s+[a-zA-Z]+\s*;)' 2>/dev/null; then
    sw_check pre-tool-use-bash "Destructive DB op" warn
    WARNINGS="${WARNINGS}Heads up: destructive database operation detected (DROP/TRUNCATE/DELETE). Verify this is intentional. "
  fi
fi

# ============================================================
# Check 4: Docker/container destructive operations
# Config: rules.destructive_commands (default: enabled)
# ============================================================
if is_rule_enabled "destructive_commands" "$PROJECT_ROOT"; then
  if echo "$SEARCH_TARGET" | grep -qE 'docker\s+(system\s+prune|container\s+prune|image\s+prune|volume\s+prune)' 2>/dev/null; then
    sw_check pre-tool-use-bash "Docker prune" warn
    WARNINGS="${WARNINGS}Heads up: docker prune removes stopped containers/unused images/volumes. "
  fi
fi

# ============================================================
# Check 5: Process killing
# Config: rules.destructive_commands (default: enabled)
# ============================================================
if is_rule_enabled "destructive_commands" "$PROJECT_ROOT"; then
  if echo "$SEARCH_TARGET" | grep -qE 'kill\s+-9|killall|pkill' 2>/dev/null; then
    sw_check pre-tool-use-bash "Process kill" warn
    WARNINGS="${WARNINGS}Heads up: process kill detected. Verify the target process. "
  fi
fi

# ============================================================
# Output result
# ============================================================
if [ -n "$WARNINGS" ]; then
  ESCAPED_WARNINGS=$(printf '%s' "$WARNINGS" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g' | tr -d '\n\r')
  echo "{\"hookSpecificOutput\":{\"decision\":\"approve\",\"message\":\"[shipworthy] Heads up: ${ESCAPED_WARNINGS}\"}}"
else
  sw_log security pre-tool-use-bash "All checks passed"
  echo '{"hookSpecificOutput":{"decision":"approve"}}'
fi
